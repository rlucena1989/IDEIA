{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "types": [
      "jest",
      "@types/react"
    ],
    "composite": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__"
  ],
  "references": [
    {
      "path": "../logger"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../event-bus"
    },
    {
      "path": "../audit-trail"
    },
    {
      "path": "../data-layer"
    },
    {
      "path": "../memory-store"
    }
  ]
}
