{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "IDEIA",
  "version": "0.1.0",
  "identifier": "com.ideia.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ && npm run dev",
    "beforeBuildCommand": "cd ../ && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IDEIA",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3001 ws://127.0.0.1:3001; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null,
      "nsis": null
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.ideia.ai/{{target}}/{{current_version}}"],
      "pubkey": "RjlhNzAyMjFmZTYyNTg5MzA1YjFkYzQxMjM0NTY3ODkwYWJjZGVmMDEyMzQ1Njc4OTBhYmNkZWYwMTIzNDU="
    },
    "deep-link": {
      "base": "ideia://",
      "desktop": {
        "windows": ["main"]
      }
    },
    "shell": {
      "sidecar": true,
      "scope": [
        {
          "name": "ideia",
          "cmd": "../node_modules/.bin/ideia",
          "args": true
        }
      ]
    },
    "notification": {
      "all": true
    }
  }
}
