{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/__tests__"
  ],
  "extends": "../../tsconfig.base.json",
  "references": [
    {
      "path": "../logger"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../event-bus"
    },
    {
      "path": "../audit-trail"
    },
    {
      "path": "../data-layer"
    },
    {
      "path": "../memory-store"
    }
  ]
}
