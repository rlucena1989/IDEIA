    },
    {
      "label": "Lint & Fix",
      "type": "npm",
      "script": "lint:fix",
      "group": "build",
      "problemMatcher": ["$eslint-stylish"],
      "detail": "ESLint com auto-fix"
    },
    {
      "label": "Format",
