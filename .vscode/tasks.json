{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All (tsc -b)",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "detail": "tsc -b — compila todos os packages"
    },
    {
      "label": "TypeCheck (tsc --noEmit)",
      "type": "npm",
      "script": "typecheck",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "detail": "tsc --noEmit — verificação de tipos sem emitir"
