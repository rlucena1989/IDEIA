{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-devkit.local/schemas/session.schema.json",
  "title": "Session",
  "description": "Schema for an IDE session",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique session identifier"
    },
    "workspace_root": {
      "type": "string",
      "description": "Absolute path to the project root"
    },
    "policy": {
      "type": "string",
      "enum": ["auto", "ask", "block"],
      "default": "ask",
      "description": "Default autonomy policy for the session"
    },
    "active_tasks": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "List of active task IDs"
    },
    "memory": {
      "type": "object",
      "properties": {
        "last_decisions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "project_context": {
          "type": "object",
          "default": {}
        }
      },
      "required": ["last_decisions", "project_context"],
      "description": "Session-level memory snapshot"
    }
  },
  "required": ["session_id", "workspace_root", "policy"]
}
