{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "command",
  "coverageAnalysis": "off",
  "thresholds": { "high": 80, "low": 60, "break": 50 },
  "mutate": [
    "packages/agent-runtime/src/**/*.ts",
    "packages/memory-store/src/**/*.ts",
    "packages/event-bus/src/**/*.ts",
    "packages/data-layer/src/**/*.ts",
    "packages/capability-matcher/src/**/*.ts",
    "packages/planning-engine/src/**/*.ts",
    "packages/context-builder/src/**/*.ts",
    "packages/prompt-economy/src/**/*.ts",
    "packages/quality-gates/src/**/*.ts",
    "packages/agent-router/src/**/*.ts",
    "packages/delivery-orchestrator/src/**/*.ts",
    "packages/prompt-security/src/**/*.ts",
    "packages/supply-chain/src/**/*.ts",
    "packages/security-middleware/src/**/*.ts",
    "packages/llm-provider/src/**/*.ts",
    "packages/policy-engine/src/**/*.ts",
    "packages/verification-layer/src/**/*.ts",
    "packages/workflow-engine/src/**/*.ts",
    "packages/confidence/src/**/*.ts",
    "packages/memory-hierarchy/src/**/*.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.test.ts", "**/*.d.ts"],
  "commandRunner": { "command": "npx jest --no-coverage --forceExit" },
  "tempDir": ".stryker-tmp",
  "cleanTempDir": true,
  "timeoutMS": 120000
}
