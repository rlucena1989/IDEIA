# ─── IDEIA Environment Configuration ───────────────────────
# Copy to .env and adjust for your environment

# Event Bus: 'auto' (try NATS, fallback to memory), 'nats', 'memory'
EVENT_BUS_TYPE=auto

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_TOKEN=

# PostgreSQL Configuration
DATABASE_URL=postgresql://ideia:ideia@localhost:5432/ideia
DATABASE_SSL=false

# ─── LLM Provider — Universal ───────────────────────────
# Set IDEIA_LLM_API_KEY and ALL OpenAI-compatible providers
# are auto-registered with fallback. No code needed.
IDEIA_LLM_API_KEY=
IDEIA_LLM_ENDPOINT=                     # Custom endpoint (optional)
IDEIA_LLM_MODEL=                        # Default model (optional)
IDEIA_LLM_REASONING=false               # Enable o1/o3/r1 reasoning models

# ─── Provider-specific API Keys (fallback to IDEIA_LLM_API_KEY) ──
# Set only what you need. Each key enables that provider automatically.
OPENAI_API_KEY=                         # https://api.openai.com/v1
OPENROUTER_API_KEY=                     # https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=                       # https://api.deepseek.com/v1
GROQ_API_KEY=                           # https://api.groq.com/openai/v1
TOGETHER_API_KEY=                       # https://api.together.xyz/v1
DEEPINFRA_API_KEY=                      # https://api.deepinfra.com/v1/openai
FIREWORKS_API_KEY=                      # https://api.fireworks.ai/inference/v1
PERPLEXITY_API_KEY=                     # https://api.perplexity.ai
CEREBRAS_API_KEY=                       # https://api.cerebras.ai/v1
SILICONFLOW_API_KEY=                    # https://api.siliconflow.cn/v1
SAMBANOVA_API_KEY=                      # https://api.sambanova.ai/v1
ANYSCALE_API_KEY=                       # https://api.endpoints.anyscale.com/v1
GEMINI_API_KEY=                         # https://generativelanguage.googleapis.com
GOOGLE_API_KEY=                         # Alias for Gemini

# ─── Ollama (local, no key needed) ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Workspace
IDEIA_WORKSPACE_ROOT=./workspace

# Logging
LOG_LEVEL=info
