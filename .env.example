# ─── IDEIA Environment Configuration ───────────────────────
# Copy to .env and adjust for your environment

# Event Bus: 'auto' (try NATS, fallback to memory), 'nats', 'memory'
EVENT_BUS_TYPE=auto

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_TOKEN=

# PostgreSQL Configuration
DATABASE_URL=postgresql://ideia:ideia@localhost:5432/ideia
DATABASE_SSL=false

# LLM Provider (optional)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Workspace
IDEIA_WORKSPACE_ROOT=./workspace

# Logging
LOG_LEVEL=info
