{
  "title": "IDEIA Platform Overview",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"] },
  "templating": { "list": [] },
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{route}}" }],
      "description": "HTTP request rate per endpoint",
      "datasource": "Prometheus"
    },
    {
      "title": "Request Duration (p95)",
      "type": "graph",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "description": "95th percentile request duration",
      "datasource": "Prometheus"
    },
    {
      "title": "Active Connections",
      "type": "singlestat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "active_connections", "legendFormat": "connections" }],
      "description": "Currently active connections",
      "datasource": "Prometheus",
      "sparkline": { "show": true }
    },
    {
      "title": "LLM Tokens Usage",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "rate(llm_tokens_total[5m])", "legendFormat": "tokens/s" }],
      "description": "LLM token consumption rate",
      "datasource": "Prometheus"
    },
    {
      "title": "LLM Request Duration",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "rate(llm_request_duration_ms_sum[5m]) / rate(llm_request_duration_ms_count[5m])", "legendFormat": "avg ms" }],
      "description": "Average LLM request duration",
      "datasource": "Prometheus"
    },
    {
      "title": "Cache Hit Ratio",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [{ "expr": "cache_hit_ratio * 100", "legendFormat": "hit ratio %" }],
      "description": "Cache effectiveness",
      "datasource": "Prometheus",
      "yaxes": [{ "max": 100, "format": "percent" }]
    },
    {
      "title": "Event Processing Rate",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [{ "expr": "rate(events_processed_total[5m])", "legendFormat": "events/s" }],
      "description": "Event bus throughput",
      "datasource": "Prometheus"
    },
    {
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [{ "expr": "memory_heap_used_bytes", "legendFormat": "heap used" }],
      "description": "Heap memory utilization",
      "datasource": "Prometheus"
    },
    {
      "title": "Agent Execution Duration",
      "type": "graph",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "targets": [{ "expr": "rate(agent_execution_duration_ms_sum[5m]) / rate(agent_execution_duration_ms_count[5m])", "legendFormat": "avg ms" }],
      "description": "Average agent execution time",
      "datasource": "Prometheus"
    },
    {
      "title": "SLO Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "targets": [{ "expr": "slo_status", "legendFormat": "{{name}}" }],
      "description": "Service Level Objective compliance",
      "datasource": "Prometheus"
    },
    {
      "title": "Health Status",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "targets": [{ "expr": "health_status", "legendFormat": "{{check}}" }],
      "description": "System component health status",
      "datasource": "Prometheus"
    }
  ],
  "schemaVersion": 27
}
