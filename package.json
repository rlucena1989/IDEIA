{
  "name": "ideia",
  "private": true,
  "description": "IDEIA â€” IDE que transforma ideias em sistemas completos",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:plugin": "cd packages/ideia-plugin && npx tsc",
    "build:app": "cd apps/ideia-app && npx theia build",
    "build:electron": "cd electron && npm run build",
    "build:installer": "node scripts/build-installer.js",
    "build:installer:win": "node scripts/build-installer.js --platform win",
    "build:installer:mac": "node scripts/build-installer.js --platform mac",
    "build:installer:linux": "node scripts/build-installer.js --platform linux",
    "clean": "rimraf packages/*/dist apps/*/lib electron/dist electron/dist-installer",
    "dev": "node apps/ideia-app/lib/backend/main.js",
    "start:electron": "cd electron && npm start",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'packages/*/src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,json,css}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,tsx,json,css}'",
    "typecheck": "tsc -b",
    "test": "jest --passWithNoTests --no-coverage --testPathIgnorePatterns=\"scripts/__tests__|tests/integration|tests/edge-cases|tests/performance|packages/prompt-security/__tests__/asvs|packages/prompt-security/__tests__/asvs-checker|packages/initiative-feedback/__tests__\"",
    "test:unit": "jest --passWithNoTests --coverage",
    "test:slow": "jest --no-coverage packages/prompt-security/__tests__/asvs packages/prompt-security/__tests__/asvs-checker packages/initiative-feedback/__tests__",
    "test:integration": "jest --config jest.e2e.config.js --passWithNoTests",
    "test:contract": "echo 'INFO: contract tests (Pact) â€” implement in F3'",
    "test:mutation": "npx stryker run",
    "quality:check": "node scripts/quality-check.mjs",
    "quality:check:ci": "node scripts/quality-check.mjs --ci",
    "verify": "npm run quality:check:ci && npm run typecheck && npm run lint && npm test",
    "perf:bench": "npx tsx tests/performance/benchmark-event-bus.ts",
    "perf:bench:all": "npx tsx tests/performance/benchmark-event-bus.ts && npx tsx tests/performance/benchmark-vector-search.ts && npx tsx tests/performance/benchmark-kg.ts && npx tsx tests/performance/benchmark-cache.ts",
    "perf:load": "k6 run tests/performance/load-test.js",
    "perf:stress": "k6 run tests/performance/stress-test.js",
    "perf:bundle": "node scripts/bundle-analyzer.js",
    "perf:bundle:gen": "esbuild packages/cli/src/index.ts --bundle --outfile=dist/perf-bundle.js --metafile=dist/meta.json",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "test:e2e:nats": "jest --no-coverage tests/integration/nats-e2e.test.ts",
    "test:e2e:pg": "jest --no-coverage tests/integration/postgres-e2e.test.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@dagger.io/dagger": "^0.12.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/testing": "^10.4.22",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "class-validator": "^0.14.4",
    "eslint-plugin-complexity": "^1.0.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.2",
    "ts-jest": "^29.4.11"
  },
  "dependencies": {
    "@theia/ai-editor": "^1.73.1"
  },
  "overrides": {
    "serialize-javascript": "6.0.2",
    "decompress": "4.2.2",
    "dompurify": "3.4.13",
    "brace-expansion": "2.0.1",
    "qs": "6.13.1",
    "uuid": "10.0.0"
  }
}
